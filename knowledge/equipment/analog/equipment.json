{
  "type": "analog",
  "description": "Analog olcum: ham deger 0..27648 -> muhendislik birimi, HH/H/L/LL alarmlari tek histerezisle (tolerans), kablo kopmasi/tasma hatasi, simulasyon.",
  "fb": "Analog_Meas",
  "fb_source": "Analog_Meas.scl",
  "fc": "Analog Measurements",
  "fc_comment": "StartWise: olcum basina bir ag. Olcumun arayuzu kendi instance DB'si (ad = olcum kodu, ör. TT3300); ham deger PLC tag'ine bagli.",
  "instance": "{name}",
  "title": "{name} - Analog_Meas",
  "tag_table": "Analogs",
  "pins": [
    { "name": "Raw",        "section": "Input",  "type": "Int",  "io": "raw", "tag": "{name}_RAW", "comment": "{name} ham analog deger" },
    { "name": "RawLow",     "section": "Input",  "type": "Int" },
    { "name": "RawHigh",    "section": "Input",  "type": "Int" },
    { "name": "ScaleLow",   "section": "Input",  "type": "Real" },
    { "name": "ScaleHigh",  "section": "Input",  "type": "Real" },
    { "name": "LimitHH",    "section": "Input",  "type": "Real" },
    { "name": "LimitH",     "section": "Input",  "type": "Real" },
    { "name": "LimitL",     "section": "Input",  "type": "Real" },
    { "name": "LimitLL",    "section": "Input",  "type": "Real" },
    { "name": "Hyst",       "section": "Input",  "type": "Real" },
    { "name": "EnHH",       "section": "Input",  "type": "Bool" },
    { "name": "EnH",        "section": "Input",  "type": "Bool" },
    { "name": "EnL",        "section": "Input",  "type": "Bool" },
    { "name": "EnLL",       "section": "Input",  "type": "Bool" },
    { "name": "Simulation", "section": "Input",  "type": "Bool" },
    { "name": "SimValue",   "section": "Input",  "type": "Real" },
    { "name": "Value",      "section": "Output", "type": "Real" },
    { "name": "AlarmHH",    "section": "Output", "type": "Bool" },
    { "name": "AlarmH",     "section": "Output", "type": "Bool" },
    { "name": "AlarmL",     "section": "Output", "type": "Bool" },
    { "name": "AlarmLL",    "section": "Output", "type": "Bool" },
    { "name": "Error",      "section": "Output", "type": "Bool" },
    { "name": "Status",     "section": "Output", "type": "Word" }
  ],
  "usage": "Okunur: \"{name}\".Value (muhendislik birimi), .AlarmHH/.AlarmH/.AlarmL/.AlarmLL, .Error. Aralik ve esikler instance DB'de: .ScaleLow/.ScaleHigh, .LimitHH/.LimitH/.LimitL/.LimitLL, .Hyst (equipment_prepare 'params' ile baslangic degeri verilir). HMI: \"{name}\".Status."
}
