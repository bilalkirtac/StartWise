{
  "type": "valve",
  "description": "Tek etkili (yay geri donuslu) vana: tek bobin cikisi, acik/kapali geri bildirim, otomatik/manuel, kilitleme, hareket izleme. Hata olunca cikis kapanir (Reset'e kadar).",
  "fb": "Valve_SA",
  "fb_source": "Valve_SA.scl",
  "fc": "Valve Blocks",
  "fc_comment": "StartWise: vana basina bir ag. Vananin arayuzu kendi instance DB'si (ad = vana kodu); saha sinyalleri PLC tag'lerine bagli.",
  "instance": "{name}",
  "title": "{name} - Valve_SA",
  "tag_table": "Valves",
  "pins": [
    { "name": "Auto",       "section": "Input",  "type": "Bool" },
    { "name": "AutoOpen",   "section": "Input",  "type": "Bool" },
    { "name": "ManOpen",    "section": "Input",  "type": "Bool" },
    { "name": "ManClose",   "section": "Input",  "type": "Bool" },
    { "name": "Interlock",  "section": "Input",  "type": "Bool" },
    { "name": "Reset",      "section": "Input",  "type": "Bool" },
    { "name": "FbOpen",     "section": "Input",  "type": "Bool", "io": "fb_open",   "tag": "{name}_Opened", "comment": "{name} acik geri bildirim" },
    { "name": "FbClosed",   "section": "Input",  "type": "Bool", "io": "fb_closed", "tag": "{name}_Closed", "comment": "{name} kapali geri bildirim" },
    { "name": "NoFbOpen",   "section": "Input",  "type": "Bool" },
    { "name": "NoFbClosed", "section": "Input",  "type": "Bool" },
    { "name": "MonTime",    "section": "Input",  "type": "Time" },
    { "name": "Simulation", "section": "Input",  "type": "Bool" },
    { "name": "Out",        "section": "Output", "type": "Bool", "io": "out",       "tag": "{name}_CMD", "comment": "{name} bobin" },
    { "name": "Opened",     "section": "Output", "type": "Bool" },
    { "name": "Closed",     "section": "Output", "type": "Bool" },
    { "name": "Moving",     "section": "Output", "type": "Bool" },
    { "name": "ErrOpen",    "section": "Output", "type": "Bool" },
    { "name": "ErrClose",   "section": "Output", "type": "Bool" },
    { "name": "Error",      "section": "Output", "type": "Bool" },
    { "name": "Status",     "section": "Output", "type": "Word" }
  ],
  "usage": "Senaryo kodu: \"{name}\".AutoOpen := ...; okunur: \"{name}\".Opened / .Closed / .Error. HMI: \"{name}\".Status, manuelde .Auto/.ManOpen/.ManClose/.Reset. Geri bildirim yoksa \"{name}\".NoFbOpen/NoFbClosed := TRUE."
}
